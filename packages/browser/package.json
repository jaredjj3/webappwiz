{
	"name": "@webappwiz/browser",
	"version": "0.0.0",
	"description": "The browser platform behind interfaces: scrolling, animation frames, device and visibility",
	"license": "MIT",
	"author": "Jared Johnson",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jaredjj3/webappwiz.git",
		"directory": "packages/browser"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"bun": "./index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"**/*.ts",
		"**/*.tsx",
		"!**/*.test.ts",
		"!**/*.test.tsx"
	],
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@webappwiz/disposable": "workspace:^",
		"@webappwiz/events": "workspace:^",
		"@webappwiz/time": "workspace:^"
	}
}
