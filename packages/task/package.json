{
	"name": "@webappwiz/task",
	"version": "0.0.0",
	"description": "Somewhere to say \"this needs doing again\" without saying when",
	"license": "MIT",
	"author": "Jared Johnson",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jaredjj3/webappwiz.git",
		"directory": "packages/task"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"bun": "./index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./browser": {
			"bun": "./browser.ts",
			"types": "./dist/browser.d.ts",
			"default": "./dist/browser.js"
		}
	},
	"files": [
		"dist",
		"**/*.ts",
		"**/*.tsx",
		"!**/*.test.ts",
		"!**/*.test.tsx"
	],
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@webappwiz/browser": "workspace:^",
		"@webappwiz/disposable": "workspace:^",
		"@webappwiz/events": "workspace:^",
		"@webappwiz/time": "workspace:^"
	}
}
