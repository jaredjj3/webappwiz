{
	"name": "@webappwiz/react",
	"version": "0.0.0",
	"description": "Wiring React to the rest of webappwiz: resources, reactive objects and external stores",
	"license": "MIT",
	"author": "Jared Johnson",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jaredjj3/webappwiz.git",
		"directory": "packages/react"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"bun": "./index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"**/*.ts",
		"**/*.tsx",
		"!**/*.test.ts",
		"!**/*.test.tsx"
	],
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@webappwiz/disposable": "workspace:^",
		"@webappwiz/events": "workspace:^"
	},
	"peerDependencies": {
		"react": "^19"
	},
	"devDependencies": {
		"@webappwiz/browser": "workspace:^",
		"@testing-library/react": "^16.3.1",
		"@types/react": "^19.1.13",
		"react": "^19.2.4",
		"react-dom": "^19.2.4"
	}
}
