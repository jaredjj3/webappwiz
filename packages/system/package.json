{
	"name": "@webappwiz/system",
	"version": "0.0.0",
	"description": "Interfaces for the things that touch the machine, so code under test doesn't",
	"license": "MIT",
	"author": "Jared Johnson",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jaredjj3/webappwiz.git",
		"directory": "packages/system"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"bun": "./index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./testing": {
			"bun": "./testing.ts",
			"types": "./dist/testing.d.ts",
			"default": "./dist/testing.js"
		}
	},
	"files": [
		"dist",
		"**/*.ts",
		"**/*.tsx",
		"!**/*.test.ts",
		"!**/*.test.tsx"
	],
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@webappwiz/log": "workspace:^",
		"@webappwiz/time": "workspace:^"
	}
}
