{
	"name": "@webappwiz/cli",
	"version": "0.0.19",
	"description": "The webappwiz CLI: keep a project in step with a webappwiz release, and check a change against its rules",
	"license": "MIT",
	"author": "Jared Johnson",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jaredjj3/webappwiz.git",
		"directory": "packages/cli"
	},
	"type": "module",
	"module": "index.ts",
	"bin": {
		"webappwiz": "./index.ts"
	},
	"exports": {
		".": "./index.ts",
		"./config": "./config.ts",
		"./webappwiz": "./webappwiz.ts"
	},
	"engines": {
		"bun": ">=1.3"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@webappwiz/scry": "workspace:*",
		"webappwiz": "workspace:*",
		"zod": "^4.4.3"
	},
	"peerDependencies": {
		"typescript": "^7"
	}
}
