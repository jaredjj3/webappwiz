{
	"name": "@webappwiz/cli",
	"version": "0.0.0",
	"description": "The webappwiz CLI: judge code against rules, sign off a diff, and manage agent skills",
	"license": "MIT",
	"author": "Jared Johnson",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jaredjj3/webappwiz.git",
		"directory": "packages/cli"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"webappwiz": "./dist/index.js"
	},
	"exports": {
		".": {
			"bun": "./index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./webappwiz": {
			"bun": "./webappwiz.ts",
			"types": "./dist/webappwiz.d.ts",
			"default": "./dist/webappwiz.js"
		},
		"./rules": {
			"bun": "./rules.ts",
			"types": "./dist/rules.d.ts",
			"default": "./dist/rules.js"
		}
	},
	"engines": {
		"bun": ">=1.3"
	},
	"files": [
		"dist",
		"**/*.ts",
		"**/*.tsx",
		"!**/*.test.ts",
		"!**/*.test.tsx",
		"templates/*.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@webappwiz/cmd": "workspace:^",
		"@webappwiz/log": "workspace:^",
		"@webappwiz/md": "workspace:^",
		"@webappwiz/rules": "workspace:^",
		"@webappwiz/system": "workspace:^",
		"@webappwiz/t": "workspace:^",
		"@webappwiz/time": "workspace:^"
	},
	"peerDependencies": {
		"typescript": "^7"
	}
}
