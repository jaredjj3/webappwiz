{
	"name": "@webappwiz/cli",
	"version": "0.0.11",
	"description": "The webappwiz CLI: keep rules and agent skills in a project, and divide a review up",
	"license": "MIT",
	"author": "Jared Johnson",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jaredjj3/webappwiz.git",
		"directory": "packages/cli"
	},
	"type": "module",
	"module": "index.ts",
	"bin": {
		"webappwiz": "./index.ts"
	},
	"exports": {
		".": "./index.ts",
		"./webappwiz": "./webappwiz.ts"
	},
	"engines": {
		"bun": ">=1.3"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@webappwiz/rules": "workspace:*",
		"webappwiz": "workspace:*"
	},
	"peerDependencies": {
		"typescript": "^7"
	}
}
