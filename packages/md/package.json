{
	"name": "@webappwiz/md",
	"version": "0.0.0",
	"description": "A markdown document as a data source: frontmatter fields, sections and code blocks",
	"license": "MIT",
	"author": "Jared Johnson",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jaredjj3/webappwiz.git",
		"directory": "packages/md"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"bun": "./index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
