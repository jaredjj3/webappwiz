{
	"name": "@webappwiz/ship",
	"version": "0.0.0",
	"description": "Releases every package in a workspace together, at one version",
	"license": "MIT",
	"author": "Jared Johnson",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jaredjj3/webappwiz.git",
		"directory": "packages/ship"
	},
	"type": "module",
	"module": "index.ts",
	"exports": {
		".": "./index.ts",
		"./testing": "./testing.ts"
	},
	"files": [
		"**/*.ts",
		"!**/*.test.ts"
	],
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@webappwiz/log": "workspace:*",
		"@webappwiz/system": "workspace:*"
	}
}
