{
	"lsp": {
		"vtsls": {
			"binary": {
				"path": "node_modules/.bin/tsc",
				"arguments": ["--lsp", "-stdio"]
			}
		},
		"biome": {
			"binary": {
				"path": "node_modules/.bin/biome",
				"arguments": ["lsp-proxy"]
			}
		}
	},
	"languages": {
		"TypeScript": {
			"formatter": { "language_server": { "name": "biome" } }
		}
	}
}
