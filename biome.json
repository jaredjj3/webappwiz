{
	"$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"useBlockStatements": "error",
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"patterns": [
							{
								"group": ["**/packages/**"],
								"message": "Import the package's public API (e.g. '@webappwiz/log') instead of reaching into packages/."
							}
						]
					}
				}
			},
			"correctness": { "noUndeclaredDependencies": "error" }
		}
	},
	"formatter": { "enabled": true }
}
